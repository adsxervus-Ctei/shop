{
  "name": "mi-tienda",
  "version": "3.0.0",
  "description": "Mi Tienda: lo que conecta a Loba (Hatillo, San Martín y Barranco de Loba). PWA + API: tienda, panel de negocios por tipo, empleados por rol y domiciliarios.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node servidor.mjs",
    "migrar": "node -e \"import('./api/db.mjs').then(async d=>{d.conectar();await d.migrar();await d.cerrar()})\"",
    "semilla": "node api/semilla.mjs",
    "llaves-push": "node -e \"const w=require('web-push');const k=w.generateVAPIDKeys();console.log('VAPID_PUBLICA='+k.publicKey+'\\nVAPID_PRIVADA='+k.privateKey)\"",
    "test": "node tests/pruebas.mjs",
    "test:api": "node --test --test-reporter=spec tests/api/api.test.mjs",
    "instalar-navegador": "npx playwright install chromium",
    "fotos": "node fotos/descargar-fotos.mjs",
    "test:v7": "node tests/pruebas-v7.mjs",
    "test:v8": "node tests/pruebas-v8.mjs",
    "test:v9": "node tests/pruebas-v9.mjs",
    "test:api9": "node --test --test-reporter=spec tests/api/v9.test.mjs",
    "test:api-sv": "node --test --test-reporter=spec tests/api/sv01.test.mjs",
    "test:sv": "node tests/pruebas-sv01.mjs",
    "test:api-sv2": "node --test --test-reporter=spec tests/api/sv02.test.mjs",
    "test:sv2": "node tests/pruebas-sv02.mjs",
    "test:sv3": "node tests/pruebas-sv3.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "author": "Powered by AXERVUS CTeI",
  "license": "UNLICENSED"
}
